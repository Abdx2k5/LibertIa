# Bascule pour tester les pages protégées (Dashboard, Profile, Admin...)
# sans avoir à se connecter. Quand true, l'app se comporte comme si un
# utilisateur factice (voir src/mocks/testAuthData.js) était connecté.
VITE_TEST_AUTH=false

# Rôle de l'utilisateur factice : "user" ou "admin" (utilisé seulement si
# VITE_TEST_AUTH=true).
VITE_TEST_AUTH_ROLE=user

# T44/T85 — Jeton d'accès public Mapbox, requis pour afficher la carte
# interactive des voyages et la carte des souvenirs géolocalisés.
# Créez un compte gratuit sur https://account.mapbox.com/access-tokens/
# Sans jeton, un message de repli est affiché à la place de la carte.
VITE_MAPBOX_TOKEN=
